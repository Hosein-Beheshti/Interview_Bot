# Copy to backend/.env and fill in your values.
# Every key here maps to a field on Settings in src/interview_bot/config.py,
# which is the only place in the codebase that reads the environment.

# ---- Model provider ---------------------------------------------------------
# "anthropic" or "gemini". Only the selected provider's key is required.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# ---- Other vendors ----------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here   # speech-to-text and text-to-speech
VOYAGE_API_KEY=your_voyage_api_key_here       # CV embeddings for retrieval

# ---- Database ---------------------------------------------------------------
# Postgres with the pgvector extension available.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_bot

# ---- Public deployment ------------------------------------------------------
# Browser origins allowed to call this API, comma-separated. The default is
# localhost only; a deployed instance MUST set this to its frontend origin.
CORS_ORIGINS=http://localhost:5173

# Set automatically by Railway on every deploy (e.g. "production"); leave unset
# locally. Only used to warn loudly at startup if CORS_ORIGINS is still the
# localhost default or "*" while this is set — do not set it by hand.
# RAILWAY_ENVIRONMENT=

# Read the client IP from X-Forwarded-For. Set true only when a proxy or load
# balancer is definitely in front of the app and rewriting that header (Railway,
# Render, Fly, nginx). Left true while the app is directly reachable, anyone can
# forge the header and reset their own rate limit.
TRUST_PROXY_HEADERS=false

# ---- Admission control ------------------------------------------------------
# The endpoints are unauthenticated and each one spends money per call, so these
# caps are what make a public URL safe. See api/limits.py.
RATE_LIMIT_ENABLED=true
SESSIONS_PER_HOUR_PER_IP=5
TURNS_PER_HOUR_PER_IP=60
CV_UPLOADS_PER_HOUR_PER_IP=5
TRANSCRIPTIONS_PER_HOUR_PER_IP=60
TTS_CHARS_PER_DAY_PER_IP=20000

# Instance-wide daily model-token ceiling — the backstop that bounds the bill no
# matter how requests are spread across addresses. 0 disables it.
# ~150K/day is roughly $0.20/day on Haiku 4.5, or about 20-30 full interviews.
# Raise it once you know what real traffic costs; a spend alert in the provider
# console is the second, independent backstop this cannot replace.
DAILY_TOKEN_CEILING=150000

# ---- Data retention ---------------------------------------------------------
# Days before a session and its uploaded CV are erased by scripts/purge_expired.py.
SESSION_RETENTION_DAYS=30

# ---- Observability (optional) -----------------------------------------------
# Self-hosted Langfuse. Tracing is best-effort and a no-op when disabled.
LANGFUSE_ENABLED=false
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
