# ─────────────────────────────────────────────────────────────────────────
# Interview Bot — backend configuration. Copy to `.env` and fill in.
# Only the LLM provider + its key and DATABASE_URL are needed to run the app;
# everything else has a working default (see src/interview_bot/config.py).
# The offline test tier (`make test`) needs NONE of these.
# ─────────────────────────────────────────────────────────────────────────

# Which LLM backend to use: "anthropic" (Claude) or "gemini" (Google).
# Set the matching API key below for whichever you choose.
LLM_PROVIDER=anthropic

# Anthropic / Claude (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MODEL=claude-haiku-4-5-20251001

# Google Gemini (required when LLM_PROVIDER=gemini)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional features — leave blank to disable.
DEEPGRAM_API_KEY=          # voice (speech-to-text / text-to-speech)
VOYAGE_API_KEY=            # CV embeddings for long-CV vector retrieval

# Database (Postgres + pgvector). The docker-compose stack sets this for you.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_bot

# Transport mode for model-provider calls — the determinism seam.
#   live    hit the provider APIs (default; what production uses)
#   record  hit the APIs AND write cassettes (scripts/record_cassettes.py)
#   replay  serve recorded cassettes from disk — no network, no API keys
# The contract test suite forces `replay` itself; you rarely set this by hand.
TRANSPORT_MODE=live

# Observability (self-hosted or cloud Langfuse). Off by default; when off it is
# a no-op and never touches the request path.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
