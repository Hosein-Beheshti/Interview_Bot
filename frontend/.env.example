# Frontend environment (optional)
# The API base is set to /api in vite.config.ts which proxies to http://localhost:8000

# Google OAuth client ID (Google Cloud Console -> Credentials). Must match the
# backend's GOOGLE_CLIENT_ID — it's the same client, used on both sides to
# verify the same audience. Baked in at build time (Vite env), so it must be
# set before `npm run build` / the frontend Docker build, not just at runtime.
VITE_GOOGLE_CLIENT_ID=
